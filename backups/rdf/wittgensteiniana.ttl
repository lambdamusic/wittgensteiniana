    schema:isPartOf <http://wittgensteiniana.michelepasin.org/id/unit/649> ;
    schema:name "3.32" ;
    schema:position 133 .

<http://wittgensteiniana.michelepasin.org/id/unit/735> a schema:Chapter ;
    schema:isPartOf <http://wittgensteiniana.michelepasin.org/id/unit/725> ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/fact-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/logical-form-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/proposition-by-wittgenstein> ;
    schema:name "4.12" ;
    schema:position 209 .

<http://wittgensteiniana.michelepasin.org/id/unit/756> a schema:Chapter ;
