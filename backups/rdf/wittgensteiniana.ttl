    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/form-of-representation-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/sense-of-the-proposition-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/state-of-affairs-by-wittgenstein> ;
    schema:name "4.2" ;
    schema:position 230 .

<http://wittgensteiniana.michelepasin.org/id/unit/796> a schema:Chapter ;
    schema:isPartOf id:tractatus ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/complex-proposition-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/elementary-proposition-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/function-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/proposition-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/truth-function-by-wittgenstein> ;
    schema:name "5" ;
    schema:position 270 .

<http://wittgensteiniana.michelepasin.org/id/unit/882> a schema:Chapter ;
    schema:isPartOf <http://wittgensteiniana.michelepasin.org/id/unit/796> ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/truth-function-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/truth-operation-by-wittgenstein> ;
    schema:name "5.5" ;
    schema:position 356 .

<http://wittgensteiniana.michelepasin.org/id/unit/902> a schema:Chapter ;
    schema:isPartOf <http://wittgensteiniana.michelepasin.org/id/unit/882> ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/truth-operation-by-wittgenstein> ;
    schema:name "5.53" ;
    schema:position 376 .

<http://wittgensteiniana.michelepasin.org/id/topic/metaphysical-subject-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "The philosophical self, or metaphysical subject, is not the self that we usually associate to the experiences of our everyday life. It is instead related to the awareness of the limits of the world and of our language: analogously to the fact that I cannot see my eye anywhere in the visual field, the self is not part of the world, but it is pressuposed by it as its limit. This theme has been previously explored by other philosophers Wittgenstein was most probably aware of, such as Schopenhauer and Hume. 5.641" ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Metaphysical Subject" .

<http://wittgensteiniana.michelepasin.org/id/topic/name-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "In a completely analysed proposition, a name is the simple sign which is given to an object. Wittgenstein also says that the meaning of the name is the object itself (although this meaning becomes apparent only in the context of the proposition)." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Name" .

<http://wittgensteiniana.michelepasin.org/id/topic/prop-of-science-concept-g558368> a schema:DefinedTerm ;
    schema:description "The proposition of science are just a description of the world, not a prescription of how the world should be or behave. They do not belong to logic, because they make claims about experience and they do not hold a priori. The particular propositions of natural science describe facts and, since they can be true or false, they are the only propositions with a sense. On the contrary, the abstract laws of science do not describe any specific fact, but are just insights about the forms the propositions describing facts can have" ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Propositions of Science" .

<http://wittgensteiniana.michelepasin.org/id/topic/propositional-sign-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Propositions are communicated by means of propositional signs through modes such as speech, writing or body language." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Propositional Sign" .

<http://wittgensteiniana.michelepasin.org/id/unit/576> a schema:Chapter ;
    schema:isPartOf <http://wittgensteiniana.michelepasin.org/id/unit/534> ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/picture-by-wittgenstein> ;
    schema:name "2.1" ;
    schema:position 50 .

<http://wittgensteiniana.michelepasin.org/id/unit/634> a schema:Chapter ;
    schema:isPartOf <http://wittgensteiniana.michelepasin.org/id/unit/613> ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/proposition-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/propositional-sign-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/sense-of-the-proposition-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/thought-by-wittgenstein> ;
    schema:name "3.2" ;
    schema:position 108 .

<http://wittgensteiniana.michelepasin.org/id/topic/laws-of-logic-concept-g549576> a schema:DefinedTerm ;
    schema:description "Logic imposes a structure on the world which is the only existing necessity - there are no laws of logic, intended as laws of inference (as Russell and Frege had stated) that tells us how logic works. Instead, whatever is ruled out by logic is ruled out because it is impossible and inconceivable." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Laws of Logic" .

<http://wittgensteiniana.michelepasin.org/id/topic/thought-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "The issue of what Wittgenstein means by thought is quite debated: for sure he is not making any psychological claims. He is interested in showing how things are, not in how we perceive things to be. In a letter to Russell (19.8.19), when Russell asked him whether a thought consisted of words, he replied: \"No! But of physical constituents that have the same sort of relation to reality as words\"." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Thought" .

<http://wittgensteiniana.michelepasin.org/id/topic/truth-possibilities-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Any elementary or complex proposition can be true or false: these are its truth-possibilites." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Truth Possibilities" .

<http://wittgensteiniana.michelepasin.org/id/unit/947> a schema:Chapter ;
    schema:isPartOf id:tractatus ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/general-propositional-form-by-wittgenstein> ;
    schema:name "6" ;
    schema:position 421 .

<http://wittgensteiniana.michelepasin.org/id/unit/961> a schema:Chapter ;
    schema:isPartOf <http://wittgensteiniana.michelepasin.org/id/unit/956> ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/language-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/prop-of-logic-concept-g394004>,
        <http://wittgensteiniana.michelepasin.org/id/topic/world-by-wittgenstein> ;
    schema:name "6.12" ;
    schema:position 435 .

<http://wittgensteiniana.michelepasin.org/id/topic/general-propositional-form-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "The general propositional form is what all propositions share in common, it is the essence of a proposition" ;
    schema:inDefinedTermSet id:topics ;
    schema:name "General Propositional Form" .

<http://wittgensteiniana.michelepasin.org/id/topic/internal-property-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "An object has internal and external properties: the internal properties are its logical form, what kind of object it is and how it can combine with other objects in states of affairs. The external properties are what is true of it, what states of affairs it does occur in." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Internal Property" .

<http://wittgensteiniana.michelepasin.org/id/unit/613> a schema:Chapter ;
    schema:isPartOf id:tractatus ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/fact-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/thought-by-wittgenstein> ;
    schema:name "3" ;
    schema:position 87 .

<http://wittgensteiniana.michelepasin.org/id/topic/variable-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "It is impossible to substitute a syntactical quality for a variable ranging over syntactical objects. In other words, a variable ranging over syntactical objects is itself a syntactical object. And we cannot substitute other entities than objects for syntactical objects. Starting from here, Wittgenstein arrives also at saying that it is impossible to attach a syntactical quality to itself: this logical fact, he claims, is 'the whole theory of types' of Russell." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Variable" .

<http://wittgensteiniana.michelepasin.org/id/topic/a-posteriori-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "With this term, in epistemology and philosophy of language, we usually refer to those contents of knowledge which are not innate or pre-existing in men, but dependent on experience." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "A Posteriori" .

<http://wittgensteiniana.michelepasin.org/id/topic/truth-function-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "The concept of truth function in Wittgenstein is used to relate complex propositions to elementary ones." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Truth Function" .

<http://wittgensteiniana.michelepasin.org/id/unit/687> a schema:Chapter ;
    schema:isPartOf id:tractatus ;
    schema:mentions <http://wittgensteiniana.michelepasin.org/id/topic/proposition-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/sense-of-the-proposition-by-wittgenstein>,
        <http://wittgensteiniana.michelepasin.org/id/topic/thought-by-wittgenstein> ;
    schema:name "4" ;
    schema:position 161 .

<http://wittgensteiniana.michelepasin.org/id/topic/object-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Objects for Wittgenstein are the components of a state of affair. Every object has a logical form, which determines how it can combine with other objects. The sum total of the objects is the substance of the world." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Object" .

<http://wittgensteiniana.michelepasin.org/id/topic/sense-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Sense belongs to pictures (propositions, thoughts), and it consists in a true or false relation with reality" ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Sense" .

<http://wittgensteiniana.michelepasin.org/id/topic/a-priori-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "With this term, in epistemology and philosophy of language, we usually refer to those contents of knowledge which are innate or pre-existing in men, so they are not dependent on experience." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "A Priori" .

<http://wittgensteiniana.michelepasin.org/id/topic/inference-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Since a complex proposition is a truth-function of its elementary constituents, Wittgenstein claims that we can rightly infer other propositions being true or false from the truth or falsity of the first one." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Inference" .

<http://wittgensteiniana.michelepasin.org/id/topic/value-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "There is no 'value' in the world, says Wittgenstein, but just accidental facts. If there was a value, it would be expressible, but since there is not it must be 'transcendent' and therefore inexpressible. Ethics and aesthetics belong to the domain of what cannot be said." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Value" .

<http://wittgensteiniana.michelepasin.org/id/topic/role-of-logic-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Since the propositions of logic 'say nothing', but show that they are true or false only by virtue of their structure, the role of logic itself is just to helps us understand the formal properties of language and the world." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Role of Logic" .

<http://wittgensteiniana.michelepasin.org/id/topic/sense-of-the-proposition-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "The sense of the proposition, as the sence of the picture, is the situation (state of affairs) represented by it." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Sense of the Proposition" .

<http://wittgensteiniana.michelepasin.org/id/topic/elementary-proposition-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "An elementary proposition is a proposition stating the existence or non existence of a simple state of affairs (e.g. an 'atomic fact')." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Elementary Proposition" .

<http://wittgensteiniana.michelepasin.org/id/topic/substance-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "In philosophy the idea of substance hints at an underlying 'layer' of the world which is unchanging and undestructible. Wittgenstein applies this idea to objects, but in a distorted manner. Objects are unchanging and undestructible, but they are also empty logical forms: we can learn from them nothing about what the world is like until they are combined in states of affairs." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Substance" .

<http://wittgensteiniana.michelepasin.org/id/topic/truth-grounds-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "The truth grounds of a proposition are the truth possibilities under which the proposition comes out true." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Truth Grounds" .

<http://wittgensteiniana.michelepasin.org/id/topic/prop-of-logic-concept-g394004> a schema:DefinedTerm ;
    schema:description "The proposition of logic are neither true or false, but senseless (they lack sense). They cannot describe the world, but they implicitly show us how the world (and language) is, namely they show its logical structure." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Propositions of Logic" .

<http://wittgensteiniana.michelepasin.org/id/topic/symbol-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Wittgenstein states that we can distinguish the sign from the symbol: in particular, the sign is what can be perceived of a symbol. One and the same sign can be common to two different symbols, which will therefore signify in different ways. For example, the word 'is' figures as the copula, as a sign of identity and as an expression for existence. This ambiguity of the surface grammar of ordinary language constitutes one of the main reasons behind philosophical confusions." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Symbol" .

<http://wittgensteiniana.michelepasin.org/id/topic/natural-science-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Natural science is the domain of propositions which have sense, with the exclusion of the nonsensical laws of science." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Natural Science" .

<http://wittgensteiniana.michelepasin.org/id/topic/fact-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "A fact (in German Tatsache) is an existing state of affairs." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Fact" .

<http://wittgensteiniana.michelepasin.org/id/topic/complex-proposition-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "A complex proposition is a truth-function of the elementary propositions composing it." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Complex Proposition" .

<http://wittgensteiniana.michelepasin.org/id/topic/proposition-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "A proposition in Wittgenstein is fundamentally a, true or false, picture of reality. However, sometimes in the text Wittgenstein uses the term 'proposition' for referring to the 'propositional sign', which is the perceived part of a proposition (e.g. the writing on a paper)." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Proposition" .

<http://wittgensteiniana.michelepasin.org/id/topic/world-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "The world, stresses Wittgenstein, is the totality of facts (i.e. of existing states of affairs), not of things." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "World" .

<http://wittgensteiniana.michelepasin.org/id/topic/truth-operation-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "A truth operation is an operation on the truth-values of propositions: by means of this operation, says Wittgenstein, we can recognize how all complex propositions are truth-functions of elementary ones." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Truth Operation" .

<http://wittgensteiniana.michelepasin.org/id/topic/logical-form-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "The logical form is the form of language and of reality - it is in fact what language and reality must have in common for language to be able to be a true or false picture of the world." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Logical Form" .

id:topics a schema:DefinedTermSet ;
    schema:name "Wittgensteiniana concept classification" .

