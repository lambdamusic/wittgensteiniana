<http://wittgensteiniana.michelepasin.org/id/topic/expression-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Wittgenstein uses the term expression as an alternative of the term symbol: the two terms mean the same thing, that is, what we perceive thanks to the sign [???]." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Expression" .

<http://wittgensteiniana.michelepasin.org/id/topic/logical-object-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "This term refers to the works of Frege and Russell. Frege builds his entire system from the primitive connective 'not' and 'if-then'. Russell builds his from 'not' and 'or'. Wittgenstein claims that logical objects that are used to define the logical structure of a proposition cannot themselves be representative of any kind of object. The elements of a proposition should hold together on their own strength, and not on the strength of these so-called logical 'objects'." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Logical Object" .

