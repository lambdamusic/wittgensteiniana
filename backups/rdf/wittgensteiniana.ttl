<http://wittgensteiniana.michelepasin.org/id/topic/nonsensical-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "With the term nonsensical (unsinnig) Wittgenstein refers to the linguistic propositions which cannot properly signify, cause they cannot be true or false." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Nonsensical" .

<http://wittgensteiniana.michelepasin.org/id/topic/representing-relation-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "This is the relation that the elements of a picture must entertain with the elements of a fact, in order to be a valid picture of reality." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Representing Relation" .

<http://wittgensteiniana.michelepasin.org/id/topic/role-of-philosophy-by-wittgenstein> a schema:DefinedTerm ;
    schema:description "Wittgenstein claims that the role of philosophy consists in clarifying language: only by doing so we would finally recognize most of the 'philosophical problems' as a nonsensical attempt to say what can only be shown." ;
    schema:inDefinedTermSet id:topics ;
    schema:name "Role of Philosophy" .

