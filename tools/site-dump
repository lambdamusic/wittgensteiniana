#!/usr/bin/env bash

set -e

# port of the local Django server; override with e.g. PORT=8011 tools/site-dump
PORT="${PORT:-8000}"
HOST="http://127.0.0.1:$PORT"

echo "================="
echo "PREREQUISITE"
echo "Ensure site is running on $HOST..."
echo "================="


if lsof -Pi :$PORT -sTCP:LISTEN -t >/dev/null ; then
    echo ">>>>>>> DJANGO is RUNNING! "
    echo "================="
else
    echo "********* Django not running **********"
    echo ".. Exiting process. Please run the django server first."
    exit 1
fi

# another project's server on the same port would get mirrored over docs/
if ! curl -s "$HOST/" | grep -q "<title>Wittgensteiniana" ; then
    echo "********* $HOST is not serving Wittgensteiniana **********"
    echo ".. Exiting process. Is another project's server on port $PORT?"
    exit 1
fi



#
# Folders ignored from build:
# - assets: managed manually for static files 
# - archived: contains legacy content which is unchanged 
#



#
# prep
#


DIR_BUILD="build"
DIR_DOCS="docs"


#
# get HTML site from local Django 
#

echo -e "\nCLEAN UP TEMP BUILD DIR.."
echo "+++++++++++++++++"
rm -rf $DIR_BUILD/*

echo -e "\nWGET SITE INTO TEMP BUILD DIRECTORY.." 
echo "+++++++++++++++++"
# wget does not follow the typewriter's edition menu (<option value>), so
# seed the Pears and German pages of every proposition explicitly
EXTRA_URLS="$DIR_BUILD/extra-urls.txt"
mkdir -p $DIR_BUILD
curl -s "$HOST/typewriter" | grep -oE 'href="/typewriter/[^"]+/"' | sed -E 's/href="([^"]+)"/\1/' | sort -u \
    | while read -r p; do echo "$HOST${p}pears/"; echo "$HOST${p}german/"; done > $EXTRA_URLS
echo "seeding $(wc -l < $EXTRA_URLS | tr -d ' ') typewriter edition URLs"

# wget exits non-zero on any 404 while crawling; the link check below is the real gate
wget  -P $DIR_BUILD -mkEpnp -nH "$HOST/" -i $EXTRA_URLS --wait=0.1 || true
rm $EXTRA_URLS

# add a log file
cd $DIR_BUILD
touch "$(date +"%Y_%m_%d_%I_%M_%p").log"
cd ..


#
# redirects, robots.txt, sitemap.xml; then refuse to publish broken links
#

echo -e "\nPOST-PROCESS BUILD.."
echo "+++++++++++++++++"
./tools/postprocess-build $DIR_BUILD

echo -e "\nCHECK INTERNAL LINKS.."
echo "+++++++++++++++++"
if ! ./tools/check-links $DIR_BUILD ; then
    echo "********* Broken internal links: $DIR_DOCS/ left untouched **********"
    exit 1
fi


#
# save HTML site to docs folder
#

echo -e "\nRSYNC TEMP BUILD DIRECTORY INTO FINAL LOCATION:  /$DIR_DOCS"
echo "+++++++++++++++++"
rsync -av --delete --exclude '.nojekyll' --exclude 'CNAME' --exclude archived --exclude assets $DIR_BUILD/ $DIR_DOCS/




# WGET HOWTO
# https://www.gnu.org/software/wget/manual/wget.html

# -   `--mirror` – Makes (among other things) the download recursive.
# -   `--convert-links` – convert all the links (also to stuff like CSS stylesheets) to relative, so it will be suitable for offline viewing.
# -   `--adjust-extension` – Adds suitable extensions to filenames (`html` or `css`) depending on their content-type.
# -   `--page-requisites` – Download things like CSS style-sheets and images required to properly display the page offline.
# -   `--no-parent` – When recursing do not ascend to the parent directory. It useful for restricting the download to only a portion of the site.
# -  `--no-host-directories` – Disable generation of host-prefixed directories. By default, invoking Wget with ‘-r http://fly.srk.fer.hr/’ will create a structure of directories beginning with fly.srk.fer.hr/. This option disables such behavior.
# -  `--wait` – Waiting time between calls. Set reasonable or random waiting times between two downloads to avoid the Connection closed by peer error.

