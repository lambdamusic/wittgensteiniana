#!/usr/bin/env python3
"""
Post-process the wget mirror before it is copied into docs/.

Writes into the build folder:
  - meta-refresh redirect pages, for every /typewriter/<num>/ogden/ URL and
    for each entry in tools/redirects.txt
  - robots.txt, pointing at the sitemap
  - sitemap.xml, listing every exported HTML page except the redirect pages

Usage:
    tools/postprocess-build [build]
"""

import html
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REDIRECTS_FILE = os.path.join(HERE, "redirects.txt")
CNAME_FILE = os.path.join(HERE, "..", "docs", "CNAME")

# marks the redirect pages, so the sitemap can leave them out
REDIRECT_MARKER = '<meta name="robots" content="noindex">'

REDIRECT_TEMPLATE = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Redirecting…</title>
<link rel="canonical" href="{canonical}">
<meta http-equiv="refresh" content="0; url={target}">
""" + REDIRECT_MARKER + """
</head>
<body>
<p>This page has moved to <a href="{target}">{canonical}</a>.</p>
</body>
</html>
"""


def site_url():
    with open(CNAME_FILE) as f:
        return "https://" + f.read().strip()


def write_redirect(root, old_path, target, base):
    """Write a meta-refresh page at old_path (a site-root path) pointing at target."""
    folder = os.path.join(root, old_path.strip("/"))
    page = os.path.join(folder, "index.html")
    if os.path.exists(page) and REDIRECT_MARKER not in open(page, encoding="utf-8").read():
        sys.exit(f"ERROR: redirect {old_path} would overwrite a real page")
    os.makedirs(folder, exist_ok=True)
    with open(page, "w", encoding="utf-8") as f:
        f.write(REDIRECT_TEMPLATE.format(target=html.escape(target),
                                         canonical=html.escape(base + target)))


def read_redirects():
    redirects = []
    with open(REDIRECTS_FILE) as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if line:
                old_path, target = line.split()
                redirects.append((old_path, target))
    return redirects


def page_url(root, path):
    """The public URL of an exported HTML file: /x/index.html -> /x/, /x.html stays."""
    rel = os.path.relpath(path, root).replace(os.sep, "/")
    if rel == "index.html":
        return "/"
    if rel.endswith("/index.html"):
        return "/" + rel[: -len("index.html")]
    return "/" + rel


def write_sitemap(root, base):
    urls = []
    for dirpath, _, filenames in os.walk(root):
        for filename in filenames:
            if not filename.endswith(".html"):
                continue
            path = os.path.join(dirpath, filename)
            if REDIRECT_MARKER in open(path, encoding="utf-8", errors="replace").read():
                continue
            urls.append(page_url(root, path))
    urls.sort(key=lambda u: (u != "/", u))
    with open(os.path.join(root, "sitemap.xml"), "w", encoding="utf-8") as f:
        f.write('<?xml version="1.0" encoding="UTF-8"?>\n')
        f.write('<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n')
        for url in urls:
            f.write(f"  <url><loc>{html.escape(base + url)}</loc></url>\n")
        f.write("</urlset>\n")
    return len(urls)


def write_robots(root, base):
    with open(os.path.join(root, "robots.txt"), "w") as f:
        f.write(f"User-agent: *\nAllow: /\n\nSitemap: {base}/sitemap.xml\n")


def main(root):
    base = site_url()

    count = 0
    typewriter = os.path.join(root, "typewriter")
    for num in sorted(os.listdir(typewriter)):
        if os.path.isfile(os.path.join(typewriter, num, "index.html")):
            write_redirect(root, f"/typewriter/{num}/ogden/", f"/typewriter/{num}/", base)
            count += 1
    print(f"wrote {count} /typewriter/<num>/ogden/ redirects")

    redirects = read_redirects()
    for old_path, target in redirects:
        write_redirect(root, old_path, target, base)
    print(f"wrote {len(redirects)} redirects from {os.path.relpath(REDIRECTS_FILE)}")

    write_robots(root, base)
    print(f"wrote sitemap.xml with {write_sitemap(root, base)} URLs, and robots.txt")


if __name__ == "__main__":
    main(sys.argv[1] if len(sys.argv) > 1 else "build")
